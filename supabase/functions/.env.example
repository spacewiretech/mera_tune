# Edge Function secrets. Copy to supabase/functions/.env for `supabase functions serve`
# (that file is git-ignored). In production set them once with:
#   supabase secrets set GEMINI_API_KEY=... MIXER_URL=... MIXER_SHARED_SECRET=... MIXPANEL_TOKEN=...
# Production keeps GEMINI_API_KEY / MIXER_URL / MIXER_SHARED_SECRET in app_config (gemini_api_key, mixer_url,
# mixer_shared_secret). Env, when set, wins over those rows; use it only for local `functions serve`.

# generate-ringtone: Google AI Studio key for the Generative Language API. Billing must be enabled
# on the owning GCP project (the 2.5 TTS previews have no free tier); restrict the key to that API.
GEMINI_API_KEY=

# generate-ringtone: base URL of the Cloud Run mixer (no trailing slash), e.g.
# https://ringtone-mixer-xxxxxxxx-el.a.run.app
MIXER_URL=

# generate-ringtone: shared secret sent as the x-mixer-secret header; must equal the Cloud Run
# MIXER_SHARED_SECRET secret (openssl rand -base64 48).
MIXER_SHARED_SECRET=

# cashfree-webhook: Mixpanel project token for server-side subscription events.
MIXPANEL_TOKEN=

# cashfree-webhook: Meta Conversions API (see AGENTS.md).
META_DATASET_ID=
META_CONVERSIONS_API_ACCESS_TOKEN=
