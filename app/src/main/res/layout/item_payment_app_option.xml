<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:minHeight="64dp"
    android:orientation="horizontal"
    android:paddingHorizontal="20dp"
    android:paddingVertical="12dp">

    <TextView
        android:id="@+id/paymentAppOptionIcon"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:fontFamily="@font/manrope_bold"
        android:gravity="center"
        android:importantForAccessibility="no"
        android:maxLines="1"
        android:textColor="@color/white"
        android:textSize="18sp"
        app:autoSizeMaxTextSize="18sp"
        app:autoSizeMinTextSize="10sp"
        app:autoSizeTextType="uniform"
        app:fontFamily="@font/manrope_bold"
        tools:background="@drawable/bg_phonepe_icon"
        tools:text="पे" />

    <TextView
        android:id="@+id/paymentAppOptionName"
        style="@style/Text.MeraTune.Label"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:textSize="16sp"
        tools:text="PhonePe" />

    <FrameLayout
        android:layout_width="22dp"
        android:layout_height="22dp">

        <View
            android:id="@+id/paymentAppOptionIndicator"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_form_option_unselected" />

        <ImageView
            android:id="@+id/paymentAppOptionCheck"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:src="@drawable/ic_check_white"
            android:visibility="gone"
            tools:visibility="visible" />
    </FrameLayout>

</LinearLayout>
