<?xml version="1.0" encoding="utf-8"?>
<!-- Final screen: sweep ring + M mark, title, generated title, ±10s controls, then both CTAs in the scroll content. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/readyScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true"
    android:overScrollMode="never"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="12dp"
        android:paddingBottom="24dp">

        <ImageView
            android:id="@+id/backButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="start"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_back_button"
            android:contentDescription="@string/back"
            android:padding="8dp"
            android:src="@drawable/ic_back" />

        <FrameLayout
            android:id="@+id/readyHero"
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:layout_marginTop="40dp">

            <com.spacewire.meratune.ui.PlaybackRingView
                android:id="@+id/readyPlaybackRing"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:ringGlowColor="@color/ready_ring_glow"
                app:ringProgressWidth="4dp"
                app:ringStyle="sweep"
                app:ringTrackColor="@color/ready_ring_track"
                app:ringTrackWidth="2dp" />

            <ImageView
                android:id="@+id/readyLogo"
                android:layout_width="100dp"
                android:layout_height="84dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:scaleType="fitCenter"
                android:src="@drawable/logo" />
        </FrameLayout>

        <TextView
            android:id="@+id/readyTitle"
            style="@style/Text.MeraTune.Headline.Large"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="36dp"
            android:gravity="center"
            android:lineSpacingExtra="6dp"
            tools:text="Ram, Aapki Ringtone Tayyar Hai!" />

        <TextView
            android:id="@+id/readyTuneName"
            style="@style/Text.MeraTune.Label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:textColor="@color/text_muted_warm"
            tools:text="Jai Shri Ram Rahul ji.." />

        <LinearLayout
            android:id="@+id/readyControls"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/rewindButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/ready_rewind"
                android:padding="2dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_rewind_10" />

            <ImageButton
                android:id="@+id/playPauseButton"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_marginHorizontal="22dp"
                android:background="@drawable/bg_play_button_gradient"
                android:contentDescription="@string/play_tune"
                android:padding="16dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_pause_white" />

            <ImageButton
                android:id="@+id/forwardButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/ready_forward"
                android:padding="2dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_forward_10" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/setRingtoneButton"
            style="@style/Widget.MeraTune.Cta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="34dp"
            android:layout_marginTop="44dp"
            android:text="@string/ready_set_ringtone"
            app:icon="@drawable/ic_music_notes_white" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/goHomeButton"
            style="@style/Widget.MeraTune.Cta.Outline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="34dp"
            android:layout_marginTop="20dp"
            android:text="@string/ready_go_home" />

    </LinearLayout>
</ScrollView>
