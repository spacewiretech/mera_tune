<?xml version="1.0" encoding="utf-8"?>
<!-- Onboarding carousel page dot: pink when selected (the current slide), grey otherwise. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="oval">
            <size
                android:width="8dp"
                android:height="8dp" />
            <solid android:color="@color/dot_active" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <size
                android:width="8dp"
                android:height="8dp" />
            <solid android:color="@color/dot_inactive" />
        </shape>
    </item>
</selector>
