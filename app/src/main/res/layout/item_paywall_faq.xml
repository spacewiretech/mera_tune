<?xml version="1.0" encoding="utf-8"?>
<!-- One paywall FAQ row (FaqAccordionController): tap the header to open or close the answer. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_paywall_faq_row"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/faqHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:minHeight="48dp"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp">

        <TextView
            android:id="@+id/faqQuestion"
            style="@style/Text.MeraTune.Body"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/text_faq"
            android:textSize="15sp"
            tools:text="What do I get with MeraTune?" />

        <ImageView
            android:id="@+id/faqChevron"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginStart="12dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_chevron_down" />
    </LinearLayout>

    <TextView
        android:id="@+id/faqAnswer"
        style="@style/Text.MeraTune.Body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        android:paddingBottom="14dp"
        android:textColor="@color/text_muted"
        android:textSize="14sp"
        android:visibility="gone"
        tools:text="Answer" />
</LinearLayout>
