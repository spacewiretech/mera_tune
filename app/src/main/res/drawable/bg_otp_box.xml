<?xml version="1.0" encoding="utf-8"?>
<!-- OTP digit box (ui/OtpInputView): gradient ring while focused or filled (activated), grey otherwise. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@drawable/bg_otp_box_active" android:state_focused="true" />
    <item android:drawable="@drawable/bg_otp_box_active" android:state_activated="true" />
    <item android:drawable="@drawable/bg_otp_box_idle" />
</selector>
