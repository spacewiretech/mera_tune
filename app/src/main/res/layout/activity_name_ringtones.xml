<?xml version="1.0" encoding="utf-8"?>
<!--
    "Ram Ki Ringtone Mil Gayi!": ringtones that already sing the entered name (create flow, between
    the form and the song picker). The header scrolls with the list (at most 20 rows); the
    "Make Your Tune" CTA and its caption stay pinned below it.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nameRingtonesRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/nameRingtonesScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="12dp"
            android:paddingBottom="8dp">

            <ImageView
                android:id="@+id/backButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="20dp"
                android:background="@drawable/bg_back_button"
                android:contentDescription="@string/back"
                android:padding="8dp"
                android:src="@drawable/ic_back" />

            <TextView
                android:id="@+id/nameRingtonesTitle"
                style="@style/Text.MeraTune.Headline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="26dp"
                android:layout_marginTop="28dp"
                android:lineSpacingExtra="6dp"
                tools:text="Ram Ki Ringtone Mil Gayi!" />

            <TextView
                android:id="@+id/nameRingtonesSubtitle"
                style="@style/Text.MeraTune.Body.Muted"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="26dp"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="4dp"
                android:text="@string/name_ringtones_subtitle" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/nameRingtonesRecycler"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never"
                tools:itemCount="5"
                tools:listitem="@layout/item_name_ringtone" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:id="@+id/nameRingtonesFooter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingTop="12dp"
        android:paddingBottom="20dp">

        <!-- About two thirds of the width as in the mock; longer translations grow up to the margins. -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/makeTuneButton"
            style="@style/Widget.MeraTune.Cta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="26dp"
            android:minWidth="260dp"
            android:paddingStart="40dp"
            android:paddingEnd="40dp"
            android:text="@string/name_ringtones_make_tune"
            app:icon="@drawable/ic_plus_white" />

        <TextView
            android:id="@+id/makeTuneCaption"
            style="@style/Text.MeraTune.Body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="26dp"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:text="@string/name_ringtones_make_tune_caption"
            android:textColor="@color/text_muted" />
    </LinearLayout>

</LinearLayout>
