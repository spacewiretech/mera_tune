<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:overScrollMode="never"
    android:paddingHorizontal="24dp"
    android:paddingTop="24dp"
    android:paddingBottom="24dp"
    android:scrollbars="none"
    android:visibility="gone"
    tools:visibility="visible">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <TextView
            android:id="@+id/createRingtoneButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="28dp"
            android:background="@drawable/bg_create_ringtone_button"
            android:fontFamily="@font/manrope_bold"
            android:gravity="center"
            android:text="@string/create_ringtone"
            android:textColor="@color/white"
            android:textSize="16sp" />


        <ImageView
            android:layout_marginTop="28dp"
            android:id="@+id/emptyStateImage"
            android:layout_width="220dp"
            android:layout_height="220dp"
            android:contentDescription="@null"
            android:scaleType="fitCenter"
            android:src="@drawable/big_logo" />

        <TextView
            android:id="@+id/emptyStateTitleLine1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:fontFamily="@font/manrope_bold"
            android:gravity="center"
            android:text="@string/empty_search_title_line1"
            android:textColor="@color/navy"
            android:textSize="22sp" />

        <TextView
            android:id="@+id/emptyStateTitleLine2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/manrope_bold"
            android:gravity="center"
            android:text="@string/empty_search_title_line2"
            android:textSize="22sp" />

        <TextView
            android:id="@+id/emptyStateMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:lineSpacingExtra="4dp"
            android:textColor="@color/text_secondary"
            android:textSize="15sp"
            tools:text="We couldn't find ringtone for Ram, Be the first to create one" />



    </LinearLayout>

</ScrollView>
