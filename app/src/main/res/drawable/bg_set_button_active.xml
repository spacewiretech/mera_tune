<?xml version="1.0" encoding="utf-8"?>
<!--
    "Active" state of the Home row pill: solid CTA gradient. Inset 4dp top/bottom like bg_row_pill,
    so it swaps in place inside Widget.MeraTune.RowPill's 48dp touch target.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:bottom="4dp"
        android:top="4dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:endColor="@color/gradient_orange"
                android:startColor="@color/gradient_pink"
                android:type="linear" />
            <corners android:radius="100dp" />
        </shape>
    </item>
</layer-list>
