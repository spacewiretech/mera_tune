<?xml version="1.0" encoding="utf-8"?>
<!-- Outline CTA (Widget.MeraTune.Cta.Outline): 1dp pink-to-orange ring around a white pill. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:endColor="@color/gradient_orange"
                android:startColor="@color/gradient_pink"
                android:type="linear" />
            <corners android:radius="100dp" />
        </shape>
    </item>
    <item
        android:bottom="1dp"
        android:left="1dp"
        android:right="1dp"
        android:top="1dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/white" />
            <corners android:radius="100dp" />
        </shape>
    </item>
</layer-list>
