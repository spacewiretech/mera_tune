<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <ScrollView
        android:id="@+id/readyScroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none"
        app:layout_constraintBottom_toTopOf="@id/setRingtoneButton"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingTop="12dp"
            android:paddingBottom="24dp">

            <ImageView
                android:id="@+id/backButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="start"
                android:background="@drawable/bg_back_button"
                android:contentDescription="@string/back"
                android:padding="8dp"
                android:src="@drawable/ic_back" />

            <FrameLayout
                android:id="@+id/readyHero"
                android:layout_width="220dp"
                android:layout_height="220dp"
                android:layout_marginTop="24dp">

                <com.spacewire.meratune.ui.PlaybackRingView
                    android:id="@+id/readyPlaybackRing"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <ImageView
                    android:id="@+id/readyLogo"
                    android:layout_width="170dp"
                    android:layout_height="170dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:scaleType="fitCenter"
                    android:src="@drawable/big_logo" />
            </FrameLayout>

            <TextView
                android:id="@+id/readyTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:lineSpacingExtra="4dp"
                android:textColor="@color/navy"
                android:textSize="24sp"
                android:textStyle="bold"
                tools:text="Ram, Aapki Ringtone Tayyar Hai!" />

            <TextView
                android:id="@+id/readyTuneName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:textColor="@color/navy"
                android:textSize="16sp"
                tools:text="Jai Shri Ram Rahul ji.." />

            <TextView
                android:id="@+id/readyBaseSong"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="2"
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                tools:text="Gaana: Ram Bhajan Hook · Female voice" />

            <LinearLayout
                android:id="@+id/readyControls"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/rewindButton"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/ready_rewind"
                    android:padding="8dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_rewind_10" />

                <ImageButton
                    android:id="@+id/playPauseButton"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:layout_marginHorizontal="28dp"
                    android:background="@drawable/bg_play_button_gradient"
                    android:contentDescription="@string/play_tune"
                    android:padding="18dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_play_white" />

                <ImageButton
                    android:id="@+id/forwardButton"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/ready_forward"
                    android:padding="8dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_forward_10" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/secondaryActionsRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/changeSongButton"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_language_option_unselected"
                    android:fontFamily="sans-serif-medium"
                    android:foreground="@drawable/fg_pill_ripple"
                    android:gravity="center"
                    android:maxLines="1"
                    android:paddingHorizontal="12dp"
                    android:text="@string/ready_change_song"
                    android:textColor="@color/navy"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:autoSizeMaxTextSize="14sp"
                    app:autoSizeMinTextSize="11sp"
                    app:autoSizeTextType="uniform" />

                <TextView
                    android:id="@+id/makeAnotherButton"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_language_option_unselected"
                    android:fontFamily="sans-serif-medium"
                    android:foreground="@drawable/fg_pill_ripple"
                    android:gravity="center"
                    android:maxLines="1"
                    android:paddingHorizontal="12dp"
                    android:text="@string/ready_make_another"
                    android:textColor="@color/navy"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:autoSizeMaxTextSize="14sp"
                    app:autoSizeMinTextSize="11sp"
                    app:autoSizeTextType="uniform" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <TextView
        android:id="@+id/setRingtoneButton"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginHorizontal="20dp"
        android:layout_marginBottom="24dp"
        android:background="@drawable/bg_create_ringtone_button"
        android:fontFamily="sans-serif-medium"
        android:foreground="@drawable/fg_pill_ripple"
        android:gravity="center"
        android:maxLines="1"
        android:paddingHorizontal="16dp"
        android:text="@string/ready_set_ringtone"
        android:textColor="@color/white"
        android:textSize="16sp"
        android:textStyle="bold"
        app:autoSizeMaxTextSize="16sp"
        app:autoSizeMinTextSize="12sp"
        app:autoSizeTextType="uniform"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
