<?xml version="1.0" encoding="utf-8"?>
<!-- "Choose preferences": name + language (UI refresh R2: no voice / category radios). -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/formScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true"
    android:overScrollMode="never"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="12dp">

        <ImageView
            android:id="@+id/backButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_back_button"
            android:contentDescription="@string/back"
            android:padding="8dp"
            android:src="@drawable/ic_back" />

        <TextView
            android:id="@+id/formTitle"
            style="@style/Text.MeraTune.Headline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:lineSpacingExtra="4dp"
            tools:text="Ram, Apne Naam Ki Ringtone Banaiye!" />

        <TextView
            android:id="@+id/formSubtitle"
            style="@style/Text.MeraTune.Body.Muted"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/create_form_subtitle" />

        <TextView
            android:id="@+id/nameSectionLabel"
            style="@style/Text.MeraTune.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/create_form_enter_name" />

        <EditText
            android:id="@+id/nameInput"
            style="@style/Widget.MeraTune.InputPill"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="@string/search_hint"
            android:imeOptions="actionDone"
            android:importantForAutofill="no"
            android:inputType="textPersonName|textCapWords"
            android:maxLength="30"
            android:maxLines="1" />

        <TextView
            android:id="@+id/nameError"
            style="@style/Text.MeraTune.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:paddingHorizontal="12dp"
            android:textColor="@color/gradient_pink"
            android:visibility="gone"
            tools:text="@string/create_form_name_invalid"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/languageSectionLabel"
            style="@style/Text.MeraTune.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="36dp"
            android:text="@string/create_form_choose_language" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <include
                    android:id="@+id/languageEnglishOption"
                    layout="@layout/item_form_option" />

                <include
                    android:id="@+id/languageTeluguOption"
                    layout="@layout/item_form_option" />

                <include
                    android:id="@+id/languageKannadaOption"
                    layout="@layout/item_form_option" />

                <include
                    android:id="@+id/languageMarathiOption"
                    layout="@layout/item_form_option" />

                <include
                    android:id="@+id/languageBengaliOption"
                    layout="@layout/item_form_option" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <include
                    android:id="@+id/languageHindiOption"
                    layout="@layout/item_form_option" />

                <include
                    android:id="@+id/languageTamilOption"
                    layout="@layout/item_form_option" />

                <include
                    android:id="@+id/languageMalayalamOption"
                    layout="@layout/item_form_option" />

                <include
                    android:id="@+id/languageOdiaOption"
                    layout="@layout/item_form_option" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/languageComingSoonNote"
            style="@style/Text.MeraTune.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:lineSpacingExtra="2dp"
            android:paddingHorizontal="16dp"
            android:textColor="@color/text_muted_warm"
            android:visibility="gone"
            tools:text="తెలుగు, தமிழ் jaldi aa raha hai"
            tools:visibility="visible" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- The spinner covers the CTA while Continue looks up existing name ringtones. -->
        <FrameLayout
            android:id="@+id/continueButtonContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="36dp"
            android:layout_marginTop="40dp"
            android:layout_marginBottom="24dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/continueButton"
                style="@style/Widget.MeraTune.Cta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/create_form_continue"
                app:icon="@drawable/ic_arrow_next_white" />

            <ProgressBar
                android:id="@+id/continueProgress"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:indeterminateTint="@color/white"
                android:visibility="gone" />
        </FrameLayout>

    </LinearLayout>
</ScrollView>
