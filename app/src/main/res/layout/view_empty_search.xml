<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:overScrollMode="never"
    android:paddingHorizontal="24dp"
    android:paddingTop="44dp"
    android:paddingBottom="24dp"
    android:scrollbars="none"
    android:visibility="gone"
    tools:visibility="visible">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/emptyStateImage"
            android:layout_width="162dp"
            android:layout_height="162dp"
            android:contentDescription="@null"
            android:scaleType="fitCenter"
            android:src="@drawable/big_logo" />

        <!-- Text set in Home.setupEmptyState (vertical gradient on the highlight). -->
        <TextView
            android:id="@+id/emptyStateTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:fontFamily="@font/manrope_bold"
            android:gravity="center"
            android:lineSpacingExtra="8dp"
            android:textColor="@color/navy"
            android:textSize="26sp"
            tools:text="Chaliye, Ek Ringtone Banate Hain Sirf Aapke Liye!" />

        <TextView
            android:id="@+id/emptyStateMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="@font/manrope_regular"
            android:gravity="center"
            android:lineSpacingExtra="6dp"
            android:textColor="@color/text_muted_warm"
            android:textSize="16sp"
            tools:text="We couldn't find ringtone for Ram, Be the first to create one" />

        <!-- Home.ensureCreateCtaVisible scrolls to this wrapper's bottom while the keyboard is open. -->
        <FrameLayout
            android:id="@+id/createRingtoneContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="32dp"
            android:layout_marginTop="32dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/createRingtoneButton"
                style="@style/Widget.MeraTune.Cta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/create_ringtone"
                app:icon="@drawable/ic_plus_white" />

            <!-- CtaButtons.setLoading: while the tap waits for the creation quota. -->
            <ProgressBar
                android:id="@+id/createRingtoneProgress"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:indeterminateTint="@color/white"
                android:visibility="gone" />

        </FrameLayout>

    </LinearLayout>

</ScrollView>
