<?xml version="1.0" encoding="utf-8"?>
<!--
    Flat picker row: 60dp category art with the translucent play disc, a one-line title, outline
    stats, and the "chuno" pill. A row / art tap only previews; chuno commits. Dividers come from
    InsetDividerDecoration (36dp insets, none after the last row).
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/songRow"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:minHeight="100dp"
    android:paddingHorizontal="36dp"
    android:paddingVertical="20dp">

    <FrameLayout
        android:id="@+id/thumbnailContainer"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:background="@drawable/bg_category_art_circle"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/thumbnailIcon"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:importantForAccessibility="no"
            tools:src="@drawable/ic_category_devotional" />

        <ImageButton
            android:id="@+id/playButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_play_overlay"
            android:contentDescription="@string/play_tune"
            android:padding="14dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_play"
            app:tint="@color/home_play_overlay_glyph" />
    </FrameLayout>

    <TextView
        android:id="@+id/songTitle"
        style="@style/Text.MeraTune.RowTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="8dp"
        android:textSize="17sp"
        app:layout_constraintBottom_toTopOf="@id/statsRow"
        app:layout_constraintEnd_toStartOf="@id/chooseButton"
        app:layout_constraintStart_toEndOf="@id/thumbnailContainer"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        tools:text="Jai Shri Ram Rahul ji..." />

    <LinearLayout
        android:id="@+id/statsRow"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="8dp"
        android:gravity="center_vertical"
        android:importantForAccessibility="no"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/chooseButton"
        app:layout_constraintStart_toEndOf="@id/thumbnailContainer"
        app:layout_constraintTop_toBottomOf="@id/songTitle">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_heart"
            app:tint="@color/text_muted" />

        <TextView
            android:id="@+id/likesCount"
            style="@style/Text.MeraTune.RowStat"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:textSize="14sp"
            tools:text="2.4k" />

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginStart="14dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_eye"
            app:tint="@color/text_muted" />

        <TextView
            android:id="@+id/viewsCount"
            style="@style/Text.MeraTune.RowStat"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:textSize="14sp"
            tools:text="19k" />
    </LinearLayout>

    <TextView
        android:id="@+id/chooseButton"
        style="@style/Widget.MeraTune.RowPill"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="82dp"
        android:text="@string/song_choice_choose"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
