<?xml version="1.0" encoding="utf-8"?>
<!--
    Three-step stepper: 32dp circles centred at 1/6, 3/6 and 5/6 of the width, hollow connector
    bars between them (their *Progress views fill via scaleX), and one label per third.
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/stepperThirdOne"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.3333" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/stepperThirdTwo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.6667" />

    <FrameLayout
        android:id="@+id/stepOneFrame"
        android:layout_width="32dp"
        android:layout_height="32dp"
        app:layout_constraintEnd_toStartOf="@id/stepperThirdOne"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <View
            android:id="@+id/stepOneCircle"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_processing_step_active" />

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:src="@drawable/ic_processing_mic"
            app:tint="@color/navy" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/stepTwoFrame"
        android:layout_width="32dp"
        android:layout_height="32dp"
        app:layout_constraintEnd_toStartOf="@id/stepperThirdTwo"
        app:layout_constraintStart_toStartOf="@id/stepperThirdOne"
        app:layout_constraintTop_toTopOf="parent">

        <View
            android:id="@+id/stepTwoCircle"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_processing_step_inactive" />

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:src="@drawable/ic_processing_music"
            app:tint="@color/navy" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/stepThreeFrame"
        android:layout_width="32dp"
        android:layout_height="32dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@id/stepperThirdTwo"
        app:layout_constraintTop_toTopOf="parent">

        <View
            android:id="@+id/stepThreeCircle"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_processing_step_inactive" />

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:src="@drawable/ic_processing_check"
            app:tint="@color/navy" />
    </FrameLayout>

    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="4dp"
        app:layout_constraintBottom_toBottomOf="@id/stepOneFrame"
        app:layout_constraintEnd_toStartOf="@id/stepTwoFrame"
        app:layout_constraintStart_toEndOf="@id/stepOneFrame"
        app:layout_constraintTop_toTopOf="@id/stepOneFrame">

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_processing_connector_inactive" />

        <View
            android:id="@+id/connectorOneProgress"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_processing_connector_active"
            android:scaleX="0"
            android:transformPivotX="0dp" />
    </FrameLayout>

    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="4dp"
        app:layout_constraintBottom_toBottomOf="@id/stepTwoFrame"
        app:layout_constraintEnd_toStartOf="@id/stepThreeFrame"
        app:layout_constraintStart_toEndOf="@id/stepTwoFrame"
        app:layout_constraintTop_toTopOf="@id/stepTwoFrame">

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_processing_connector_inactive" />

        <View
            android:id="@+id/connectorTwoProgress"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_processing_connector_active"
            android:scaleX="0"
            android:transformPivotX="0dp" />
    </FrameLayout>

    <TextView
        android:id="@+id/stepOneLabel"
        style="@style/Text.MeraTune.Body"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:lineSpacingExtra="2dp"
        android:paddingHorizontal="4dp"
        android:text="@string/processing_step_preparing"
        app:layout_constraintEnd_toStartOf="@id/stepperThirdOne"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/stepOneFrame" />

    <TextView
        android:id="@+id/stepTwoLabel"
        style="@style/Text.MeraTune.Body"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:lineSpacingExtra="2dp"
        android:paddingHorizontal="4dp"
        android:text="@string/processing_step_composing"
        app:layout_constraintEnd_toStartOf="@id/stepperThirdTwo"
        app:layout_constraintStart_toStartOf="@id/stepperThirdOne"
        app:layout_constraintTop_toBottomOf="@id/stepTwoFrame" />

    <TextView
        android:id="@+id/stepThreeLabel"
        style="@style/Text.MeraTune.Body"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:lineSpacingExtra="2dp"
        android:paddingHorizontal="4dp"
        android:text="@string/processing_step_ready"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@id/stepperThirdTwo"
        app:layout_constraintTop_toBottomOf="@id/stepThreeFrame"
        tools:text="Ringtone Ready!" />

</androidx.constraintlayout.widget.ConstraintLayout>
