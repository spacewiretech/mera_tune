<?xml version="1.0" encoding="utf-8"?>
<!--
    Terms footer of the phone, OTP and name screens. The include's id (authFooter) replaces this
    root id; each activity binds it with AuthTermsHelper.bind (gradient, underlined links).
-->
<TextView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/termsText"
    style="@style/Text.MeraTune.Footer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center"
    android:lineSpacingExtra="2dp"
    android:paddingHorizontal="24dp"
    android:text="@string/auth_terms"
    android:textColorHighlight="@android:color/transparent" />
