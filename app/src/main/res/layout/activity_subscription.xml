<?xml version="1.0" encoding="utf-8"?>
<!--
    Paywall with its in-activity Payment Pending / Payment Failed screens (SubscriptionActivity
    shows one of the three containers; the root background follows the visible one).
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/subscriptionRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_paywall">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/paywallContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Hidden: kept for the WIP logout path (logged_out source=subscription). -->
        <TextView
            android:id="@+id/logoutButton"
            style="@style/Text.MeraTune.Body"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:background="@drawable/bg_logout_outline"
            android:gravity="center"
            android:paddingHorizontal="16dp"
            android:text="@string/subscription_logout"
            android:textSize="14sp"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ScrollView
            android:id="@+id/subscriptionScroll"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:scrollbars="none"
            app:layout_constraintBottom_toTopOf="@id/bottomBar"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <LinearLayout
                android:id="@+id/paywallScrollContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="20dp"
                android:paddingTop="8dp"
                android:paddingBottom="24dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <FrameLayout
                        android:id="@+id/videoContainer"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:background="@drawable/bg_paywall_video_card"
                        android:padding="1dp"
                        app:layout_constraintDimensionRatio="H,1:1"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintWidth_max="@dimen/content_max_width">

                        <androidx.media3.ui.PlayerView
                            android:id="@+id/subscriptionVideoPlayer"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/bg_video_player_rounded"
                            android:clipToOutline="true"
                            app:resize_mode="zoom"
                            app:show_buffering="when_playing"
                            app:shutter_background_color="@android:color/transparent"
                            app:surface_type="texture_view"
                            app:use_controller="false" />

                        <View
                            android:id="@+id/videoScrim"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@color/video_scrim"
                            android:importantForAccessibility="no" />

                        <ImageView
                            android:id="@+id/playButton"
                            android:layout_width="52dp"
                            android:layout_height="52dp"
                            android:layout_gravity="center"
                            android:background="@drawable/bg_play_circle"
                            android:contentDescription="@string/subscription_play_video"
                            android:padding="14dp"
                            android:src="@drawable/ic_play_white" />

                        <!-- 40dp disc in a 48dp touch target; opens Home (the old header close X). -->
                        <ImageButton
                            android:id="@+id/homeButton"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:layout_gravity="top|end"
                            android:layout_margin="4dp"
                            android:background="@drawable/bg_paywall_home_button"
                            android:contentDescription="@string/paywall_home_button"
                            android:padding="14dp"
                            android:scaleType="fitCenter"
                            android:src="@drawable/ic_home" />
                    </FrameLayout>
                </androidx.constraintlayout.widget.ConstraintLayout>

                <TextView
                    android:id="@+id/paywallTitle"
                    style="@style/Text.MeraTune.Title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:accessibilityHeading="true"
                    android:gravity="center"
                    android:text="@string/paywall_title"
                    android:textSize="22sp" />

                <!--
                    Negative margins here and on renewalText trim the hero price's Manrope ascent and
                    descent (about a third of its height), so the gaps read like the mock.
                -->
                <LinearLayout
                    android:id="@+id/priceRow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="-6dp"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/originalPrice"
                        style="@style/Text.MeraTune.Body"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:importantForAccessibility="no"
                        android:textColor="@color/text_muted"
                        android:textSize="24sp"
                        tools:text="₹299" />

                    <!-- dp, not sp: the hero price must not grow with the font scale. -->
                    <TextView
                        android:id="@+id/offerPrice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:fontFamily="@font/manrope_extrabold"
                        android:importantForAccessibility="no"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:textColor="@color/gradient_pink"
                        android:textSize="68dp"
                        app:fontFamily="@font/manrope_extrabold"
                        tools:ignore="SpUsage"
                        tools:text="₹3" />
                </LinearLayout>

                <TextView
                    android:id="@+id/renewalText"
                    style="@style/Text.MeraTune.Label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="-8dp"
                    android:gravity="center"
                    android:textSize="16sp"
                    tools:text="Then ₹299/month • Cancel anytime" />

                <LinearLayout
                    android:id="@+id/benefitsCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_paywall_benefits_card"
                    android:orientation="vertical"
                    android:paddingHorizontal="16dp"
                    android:paddingTop="14dp"
                    android:paddingBottom="16dp">

                    <TextView
                        style="@style/Text.MeraTune.Title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:accessibilityHeading="true"
                        android:fontFamily="@font/manrope_bold"
                        android:text="@string/paywall_benefits_title"
                        android:textSize="18sp"
                        app:fontFamily="@font/manrope_bold" />

                    <!-- Check top-aligned with the first line, so wrapped rows read as in the mock. -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_benefit_check" />

                        <TextView
                            style="@style/Text.MeraTune.Body"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:textSize="15sp"
                            android:text="@string/paywall_benefit_names" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_benefit_check" />

                        <TextView
                            style="@style/Text.MeraTune.Body"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:textSize="15sp"
                            android:text="@string/paywall_benefit_photo" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_benefit_check" />

                        <TextView
                            style="@style/Text.MeraTune.Body"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:textSize="15sp"
                            android:text="@string/paywall_benefit_family" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_benefit_check" />

                        <TextView
                            style="@style/Text.MeraTune.Body"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:textSize="15sp"
                            android:text="@string/paywall_benefit_monthly" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    style="@style/Text.MeraTune.Label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:accessibilityHeading="true"
                    android:drawablePadding="8dp"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="12dp"
                    android:text="@string/paywall_faq_title"
                    android:textSize="20sp"
                    app:drawableStartCompat="@drawable/ic_info_outline" />

                <LinearLayout
                    android:id="@+id/faqContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="8dp"
                    android:layout_marginTop="12dp"
                    android:orientation="vertical" />
            </LinearLayout>
        </ScrollView>

        <LinearLayout
            android:id="@+id/bottomBar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="10dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_paywall_bottom_bar"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="10dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <LinearLayout
                android:id="@+id/paymentAppSelector"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:background="@drawable/bg_payment_selector"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="4dp"
                android:paddingEnd="4dp">

                <TextView
                    android:id="@+id/paymentAppIcon"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_phonepe_icon"
                    android:fontFamily="@font/manrope_bold"
                    android:gravity="center"
                    android:importantForAccessibility="no"
                    android:maxLines="1"
                    android:textColor="@color/white"
                    android:textSize="18sp"
                    app:autoSizeMaxTextSize="18sp"
                    app:autoSizeMinTextSize="10sp"
                    app:autoSizeTextType="uniform"
                    app:fontFamily="@font/manrope_bold"
                    tools:text="पे" />

                <TextView
                    android:id="@+id/paymentAppName"
                    style="@style/Text.MeraTune.Label"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/subscription_phonepe" />

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_chevron_down" />
            </LinearLayout>

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1.05">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/tryNowButton"
                    style="@style/Widget.MeraTune.Cta"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:maxLines="1"
                    android:minHeight="0dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="@string/paywall_cta"
                    app:autoSizeMaxTextSize="20sp"
                    app:autoSizeMinTextSize="14sp"
                    app:autoSizeTextType="uniform" />

                <ProgressBar
                    android:id="@+id/loadingIndicator"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_gravity="center"
                    android:indeterminateTint="@color/white"
                    android:visibility="gone" />
            </FrameLayout>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <include
        android:id="@+id/pendingContainer"
        layout="@layout/view_payment_pending"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <include
        android:id="@+id/failedContainer"
        layout="@layout/view_payment_failed"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />
</FrameLayout>
