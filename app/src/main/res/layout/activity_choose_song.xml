<?xml version="1.0" encoding="utf-8"?>
<!-- "Choose ringtones": the header scrolls with the list (at most 10 rows, so no recycling concern). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/chooseSongRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/chooseSongScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp">

            <LinearLayout
                android:id="@+id/chooseSongHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="12dp">

                <ImageView
                    android:id="@+id/backButton"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="20dp"
                    android:background="@drawable/bg_back_button"
                    android:contentDescription="@string/back"
                    android:padding="8dp"
                    android:src="@drawable/ic_back" />

                <TextView
                    android:id="@+id/songChoiceTitle"
                    style="@style/Text.MeraTune.Headline"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="26dp"
                    android:layout_marginTop="28dp"
                    android:lineSpacingExtra="6dp"
                    tools:text="Ram Ke Liye Kaunsi Dhun Pasand Hai?" />

                <TextView
                    android:id="@+id/songChoiceSubtitle"
                    style="@style/Text.MeraTune.Body.Muted"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="26dp"
                    android:layout_marginTop="8dp"
                    android:lineSpacingExtra="4dp"
                    tools:text="Ek ringtone choose karo, hum usse Ram ke naam mein bana denge." />

                <TextView
                    android:id="@+id/fallbackBanner"
                    style="@style/Text.MeraTune.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="26dp"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_fallback_banner"
                    android:lineSpacingExtra="2dp"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="10dp"
                    android:textColor="@color/navy"
                    android:visibility="gone"
                    tools:text="தமிழ் me gaane nahi mile, Hindi gaane dikha rahe hain"
                    tools:visibility="visible" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/voiceChipsRecycler"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:clipToPadding="false"
                    android:nestedScrollingEnabled="false"
                    android:overScrollMode="never"
                    android:paddingHorizontal="26dp"
                    android:visibility="gone"
                    tools:listitem="@layout/item_filter_chip"
                    tools:visibility="visible" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/categoryChipsRecycler"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:clipToPadding="false"
                    android:nestedScrollingEnabled="false"
                    android:overScrollMode="never"
                    android:paddingHorizontal="26dp"
                    android:visibility="gone"
                    tools:listitem="@layout/item_filter_chip"
                    tools:visibility="visible" />
            </LinearLayout>

            <FrameLayout
                android:id="@+id/chooseSongContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/songsRecycler"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    android:overScrollMode="never"
                    android:visibility="gone"
                    tools:listitem="@layout/item_song_choice"
                    tools:visibility="visible" />

                <LinearLayout
                    android:id="@+id/skeletonContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <include layout="@layout/item_song_choice_skeleton" />

                    <include layout="@layout/item_song_choice_skeleton" />

                    <include layout="@layout/item_song_choice_skeleton" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/emptyContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingHorizontal="24dp"
                    android:paddingTop="16dp"
                    android:paddingBottom="24dp"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="160dp"
                        android:layout_height="160dp"
                        android:contentDescription="@null"
                        android:scaleType="fitCenter"
                        android:src="@drawable/big_logo" />

                    <TextView
                        android:id="@+id/emptyTitle"
                        style="@style/Text.MeraTune.Title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:gravity="center"
                        android:text="@string/song_choice_empty_title" />

                    <TextView
                        android:id="@+id/emptyMessage"
                        style="@style/Text.MeraTune.Body.Muted"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:gravity="center"
                        android:lineSpacingExtra="4dp"
                        tools:text="தமிழ் ke gaane jaldi aa rahe hain. Tab tak Hindi gaane try karein?" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/emptyHindiButton"
                        style="@style/Widget.MeraTune.Cta"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="12dp"
                        android:layout_marginTop="28dp"
                        android:text="@string/song_choice_empty_hindi_cta" />

                    <TextView
                        android:id="@+id/emptyChangeLanguageButton"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:layout_marginTop="8dp"
                        android:background="?attr/selectableItemBackground"
                        android:fontFamily="@font/manrope_bold"
                        android:gravity="center"
                        android:paddingHorizontal="20dp"
                        android:text="@string/song_choice_empty_change_language"
                        android:textColor="@color/gradient_pink"
                        android:textSize="15sp"
                        app:fontFamily="@font/manrope_bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/errorText"
                    style="@style/Text.MeraTune.Body.Muted"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:background="?attr/selectableItemBackground"
                    android:gravity="center"
                    android:lineSpacingExtra="4dp"
                    android:padding="24dp"
                    android:visibility="gone"
                    tools:text="No internet connection. Please check your network and try again.\n\nTap to retry."
                    tools:visibility="visible" />
            </FrameLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</FrameLayout>
