<?xml version="1.0" encoding="utf-8"?>
<!-- Focused or filled OTP box: 1dp orange (top) to pink (bottom) ring on white. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="@color/gradient_pink"
                android:startColor="@color/gradient_orange"
                android:type="linear" />
            <corners android:radius="4dp" />
        </shape>
    </item>
    <item
        android:bottom="1dp"
        android:left="1dp"
        android:right="1dp"
        android:top="1dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/white" />
            <corners android:radius="3dp" />
        </shape>
    </item>
</layer-list>
