<?xml version="1.0" encoding="utf-8"?>
<!--
    Outlined gradient pill for the row Set / chuno buttons (Widget.MeraTune.RowPill).
    Inset 4dp top/bottom so the visible pill is 40dp inside a 48dp touch target.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:bottom="4dp"
        android:top="4dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="45"
                android:endColor="@color/gradient_pink"
                android:startColor="@color/gradient_orange"
                android:type="linear" />
            <corners android:radius="100dp" />
        </shape>
    </item>
    <item
        android:bottom="5dp"
        android:left="1dp"
        android:right="1dp"
        android:top="5dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/white" />
            <corners android:radius="100dp" />
        </shape>
    </item>
</layer-list>
