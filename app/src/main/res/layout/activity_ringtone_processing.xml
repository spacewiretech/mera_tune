<?xml version="1.0" encoding="utf-8"?>
<!--
    Processing: M mark, title, the (accurate) duration subtitle and the stepper sit a little below
    centre; the full-bleed waveform and the footer are pinned to the bottom. fillViewport lets the
    ConstraintLayout fill tall screens and scroll on short ones.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/processingScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true"
    android:overScrollMode="never"
    android:scrollbars="none">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:id="@+id/processingContent"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="24dp"
            android:layout_marginTop="32dp"
            android:layout_marginBottom="32dp"
            android:animateLayoutChanges="true"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            app:layout_constraintBottom_toTopOf="@id/processingWaveform"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.6">

            <ImageView
                android:id="@+id/processingLogo"
                android:layout_width="48dp"
                android:layout_height="40dp"
                android:contentDescription="@null"
                android:scaleType="fitCenter"
                android:src="@drawable/logo" />

            <TextView
                android:id="@+id/processingTitle"
                style="@style/Text.MeraTune.Headline.Large"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center"
                android:lineSpacingExtra="6dp"
                tools:text="Ram, Aapke Naam Ki Ringtone Ban Rahi Hai" />

            <TextView
                android:id="@+id/processingSubtitle"
                style="@style/Text.MeraTune.Body.Muted"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:lineSpacingExtra="4dp"
                android:textSize="17sp"
                tools:text="Bas 10–15 second me aapki ringtone taiyar!" />

            <include
                android:id="@+id/processingStepper"
                layout="@layout/view_processing_stepper"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp" />

            <LinearLayout
                android:id="@+id/processingErrorContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:visibility="gone"
                tools:visibility="visible">

                <TextView
                    android:id="@+id/errorTitle"
                    style="@style/Text.MeraTune.Headline"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="@string/processing_error_title"
                    android:textSize="22sp" />

                <TextView
                    android:id="@+id/errorMessage"
                    style="@style/Text.MeraTune.Body.Muted"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center"
                    android:lineSpacingExtra="4dp"
                    tools:text="@string/processing_error_network" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/primaryActionButton"
                    style="@style/Widget.MeraTune.Cta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="32dp"
                    android:layout_marginTop="28dp"
                    tools:text="@string/processing_retry" />

                <TextView
                    android:id="@+id/chooseAnotherButton"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginTop="8dp"
                    android:background="?attr/selectableItemBackground"
                    android:fontFamily="@font/manrope_bold"
                    android:gravity="center"
                    android:paddingHorizontal="20dp"
                    android:text="@string/processing_choose_another"
                    android:textColor="@color/gradient_pink"
                    android:textSize="15sp"
                    app:fontFamily="@font/manrope_bold" />
            </LinearLayout>
        </LinearLayout>

        <com.spacewire.meratune.ui.WaveformView
            android:id="@+id/processingWaveform"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_marginBottom="24dp"
            app:layout_constraintBottom_toTopOf="@id/processingFooter"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <TextView
            android:id="@+id/processingFooter"
            style="@style/Text.MeraTune.Body"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="24dp"
            android:layout_marginBottom="64dp"
            android:gravity="center"
            android:text="@string/processing_footer"
            android:textSize="17sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
