<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Lane B: create flow, existing name ringtones ("Ram Ki Ringtone Mil Gayi!").
        View styles (style="@style/..."), each with an explicit android:fontFamily + fontFamily.
    -->

    <!-- "Male voice" / "Female voice": pink label on the light pink bg_voice_badge pill. -->
    <style name="Text.MeraTune.VoiceBadge">
        <item name="android:background">@drawable/bg_voice_badge</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:paddingTop">3dp</item>
        <item name="android:paddingBottom">3dp</item>
        <item name="android:fontFamily">@font/manrope_medium</item>
        <item name="fontFamily">@font/manrope_medium</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/gradient_pink</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>
</resources>
