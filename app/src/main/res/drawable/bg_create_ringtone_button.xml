<?xml version="1.0" encoding="utf-8"?>
<!--
    Primary CTA background (Widget.MeraTune.Cta and legacy TextView CTAs). The disabled look
    comes from isEnabled=false through this selector, never from alpha.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@drawable/bg_cta_disabled" android:state_enabled="false" />
    <item android:drawable="@drawable/bg_cta_gradient" />
</selector>
